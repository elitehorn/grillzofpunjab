# Grillz of Punjab site block — merge into /etc/caddy/Caddyfile
# Direct address-bar visits to JS/CSS and non-page online-order paths return 404.
# <script> and <link> still load because Sec-Fetch-Dest is script/style.

grillzofpunjab.com, www.grillzofpunjab.com {
	root * /var/www/grillzofpunjab
	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	@xml path *.xml
	header @xml Content-Type "application/xml; charset=utf-8"

	@noindex path *.js *.css *.json *.map *.webmanifest
	header @noindex X-Robots-Tag "noindex, nofollow"

	@direct_asset {
		path *.js *.css *.map *.webmanifest
		header Sec-Fetch-Dest document
	}
	error @direct_asset 404

	# Only /online-order/ and /online-order/index.html open as pages.
	# Direct visits to other files under /online-order/ return 404.
	@direct_online_order {
		path /online-order/*
		not path /online-order/ /online-order/index.html
		header Sec-Fetch-Dest document
	}
	error @direct_online_order 404

	handle_errors {
		rewrite * /404.html
		file_server
	}

	file_server {
		hide .git* .nojekyll schema.json order.js
	}
}
